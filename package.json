{
  "name": "factorynote",
  "private": true,
  "description": "Human-Gated Plan generation workflow package — harness-agnostic 3-stage pipeline.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && bun run build:viewer && bun scripts/install.mjs",
    "build:viewer": "cd apps/plan-viewer && bun run build",
    "typecheck": "tsc -b",
    "deploy": "bun scripts/install.mjs",
    "clean": "git clean -fdX packages apps"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "happy-dom": "^20.11.2",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0"
  }
}
